# Shared configuration for the disposable OPC PLC harness.
# Shell scripts source this file directly, and it is intended to become
# the stable configuration surface for a future MCP-based control path.

CP1_HOST=192.168.1.26
CP1_USER=williamwatson
SSH_KEY=$HOME/.ssh/cp1_ed25519

KUBE_NAMESPACE=workloads
APP_LABEL=app.kubernetes.io/name=opc-plc
DEPLOYMENT_NAME=opc-plc
SERVICE_NAME=opc-plc

LIVE_OPC_ENDPOINT=opc.tcp://192.168.1.26:50000
ROLL_OUT_TIMEOUT=180s
