@page "/audit"
@attribute [Authorize(Roles = HmiRoles.Admin)]
@inject HttpClient Http

<PageTitle>Audit Log</PageTitle>

<section class="page-header">
    <div>
        <div class="hmi-kicker">Administration</div>
        <h2>Audit Log</h2>
    </div>
    <p>Durable evidence for operator commands, alarm acknowledgements, and configuration changes.</p>
</section>

<section class="panel-card">
    <div class="hmi-form-grid hmi-form-grid-4">
        <label><span>Actor</span><input @bind="_actor" /></label>
        <label><span>Action</span><input @bind="_actionType" /></label>
        <label><span>From</span><input @bind="_fromLocal" placeholder="2026-08-01 08:00" /></label>
        <label><span>To</span><input @bind="_toLocal" placeholder="2026-08-08 08:00" /></label>
    </div>
    <div class="button-row">
        <button class="hmi-primary-button" @onclick="() => LoadAsync(1)">Apply Filters</button>
        <button class="hmi-ghost-button" @onclick="ClearFilters">Clear</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="notice-banner notice-banner-error">@_error</div>
}

<section class="panel-card">
    <div class="panel-label">@_total records</div>
    @if (_items.Count == 0)
    {
        <p>No audit records match these filters.</p>
    }
    else
    {
        <div class="runtime-alarms-list">
            @foreach (var item in _items)
            {
                <article class="runtime-alarm-item">
                    <div class="runtime-alarm-heading"><strong>@item.ActionType</strong><span class="status-pill">@item.Result</span></div>
                    <div class="runtime-alarm-meta">@item.ActorUsername (@item.ActorRole) • @item.Resource</div>
                    @if (!string.IsNullOrWhiteSpace(item.Detail)) { <div class="runtime-alarm-meta">@item.Detail</div> }
                    <div class="runtime-alarm-meta">@item.OccurredUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") • @item.CorrelationId</div>
                </article>
            }
        </div>
    }
    <div class="button-row">
        <button class="hmi-ghost-button" disabled="@(_page <= 1)" @onclick="() => LoadAsync(_page - 1)">Previous</button>
        <span class="setting-value">Page @_page</span>
        <button class="hmi-ghost-button" disabled="@(_page * PageSize >= _total)" @onclick="() => LoadAsync(_page + 1)">Next</button>
    </div>
</section>

@code {
    private const int PageSize = 100;
    private readonly List<AuditItem> _items = [];
    private string _actor = string.Empty;
    private string _actionType = string.Empty;
    private string _fromLocal = DateTime.Now.AddDays(-7).ToString("yyyy-MM-ddTHH:mm");
    private string _toLocal = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
    private string? _error;
    private int _page = 1;
    private int _total;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private async Task LoadAsync(int page)
    {
        _error = null;
        try
        {
            var query = new Dictionary<string, string> { ["page"] = page.ToString(), ["pageSize"] = PageSize.ToString(), ["fromUtc"] = ToUtc(_fromLocal), ["toUtc"] = ToUtc(_toLocal) };
            if (!string.IsNullOrWhiteSpace(_actor)) query["actor"] = _actor.Trim();
            if (!string.IsNullOrWhiteSpace(_actionType)) query["actionType"] = _actionType.Trim();
            var url = "/api/hmi/designer/audit?" + string.Join("&", query.Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value)}"));
            var payload = await Http.GetFromJsonAsync<AuditPayload>(url);
            _items.Clear();
            _items.AddRange(payload?.Items ?? []);
            _total = payload?.Total ?? 0;
            _page = page;
        }
        catch (Exception ex) { _error = $"Unable to load audit records: {ex.Message}"; }
    }

    private void ClearFilters() { _actor = _actionType = string.Empty; _fromLocal = DateTime.Now.AddDays(-7).ToString("yyyy-MM-ddTHH:mm"); _toLocal = DateTime.Now.ToString("yyyy-MM-ddTHH:mm"); _ = LoadAsync(1); }
    private static string ToUtc(string local) => DateTime.TryParse(local, out var value) ? value.ToUniversalTime().ToString("O") : DateTime.UtcNow.ToString("O");
    private sealed record AuditPayload(int Total, int Page, int PageSize, IReadOnlyList<AuditItem> Items);
    private sealed record AuditItem(long Id, string ActorUsername, string ActorRole, string ActionType, string Resource, string Result, string? CorrelationId, string? Detail, DateTimeOffset OccurredUtc);
}
