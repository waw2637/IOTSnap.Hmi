    private HmiProjectPackage BuildPackageFromCurrentSelection()
    {
        var screen = _draft is not null
            ? _draft
            : _selectedScreen is not null
                ? new DraftScreenDto(
                    _selectedScreen.Name,
                    _selectedScreen.Slug,
                    _selectedScreen.Width,
                    _selectedScreen.Height,
                    string.Empty,
                    string.Empty,
                    _selectedScreen.Widgets.Select(ToDraftWidgetDtoFromScreen).ToList())
                : new DraftScreenDto(_createName, _createSlug, _createWidth, _createHeight, string.Empty, string.Empty, Array.Empty<DraftWidgetDto>());

        var packageScreen = new HmiProjectPackageScreen(
            screen.Name,
            screen.Slug,
            screen.Width,
            screen.Height,
            _selectedScreen?.IsPublished ?? false,
            screen.Widgets.Select(ToPackageWidget));

        return HmiProjectPackage.Create(packageScreen);
    }

