    private void SyncEditorWidgetsFromCurrentSelection()
    {
        var widgets = new List<WidgetEditorItem>();

        if (_draft is not null)
        {
            widgets.AddRange(_draft.Widgets.Select(ToEditorWidget));
        }
        else if (_selectedScreen is not null)
        {
            widgets.AddRange(_selectedScreen.Widgets.Select(ToEditorWidget));
        }

        _editorWidgets = widgets;

        if (_selectedEditorWidget is not null)
        {
            var existing = _editorWidgets.FirstOrDefault(x => x.Key == _selectedEditorWidget.Key);
            if (existing is not null)
            {
                _selectedEditorWidget = existing;
                return;
            }
        }

        _selectedEditorWidget = _editorWidgets.FirstOrDefault();
    }

    private void SelectEditorWidget(string key)
    {
        _selectedEditorWidget = _editorWidgets.FirstOrDefault(x => x.Key == key);
    }

    private void AddBindingToSelectedWidget()
    {
        if (_selectedEditorWidget is null)
        {
            return;
        }

        _selectedEditorWidget.Bindings.Add(new WidgetBindingEditorItem("Text", "OpcTag", string.Empty, false, HmiRoles.Viewer));
    }

    private async Task SaveWidgetEditsAsync()
    {
        if (_selectedEditorWidget is null)
        {
            return;
        }

        if (_selectedScreen is not null)
        {
            var widgets = _editorWidgets.Select(ToWidgetUpsertDto).ToList();
            var payload = new UpdateScreenRequest(
                _selectedScreen.Name,
                _selectedScreen.Slug,
                _selectedScreen.Width,
                _selectedScreen.Height,
                widgets);

            var response = await Http.PutAsJsonAsync($"/api/hmi/designer/screens/{_selectedScreen.Id}", payload);
            if (!response.IsSuccessStatusCode)
            {
                _message = await response.Content.ReadAsStringAsync();
                _messageIsError = true;
                return;
            }

            await LoadScreenDetailsAsync(_selectedScreen.Slug);
            _message = "Widget properties saved.";
            _messageIsError = false;
            return;
        }

        if (_draft is not null)
        {
            _draft = new DraftScreenDto(
                _draft.Name,
                _draft.Slug,
                _draft.Width,
                _draft.Height,
                _draft.Prompt,
                _draft.SketchNotes,
                _editorWidgets.Select(ToDraftWidgetDto).ToList());
            SyncEditorWidgetsFromCurrentSelection();
            _message = "Draft widget properties updated.";
            _messageIsError = false;
        }
    }

    private async Task PublishAsync(int screenId)
    {
        var response = await Http.PostAsync($"/api/hmi/designer/screens/{screenId}/publish", null);
        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
