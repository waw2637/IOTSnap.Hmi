    private void OpenRuntimeAsync(string slug)
    {
        NavigationManager.NavigateTo($"/runtime/{slug}");
    }

    private async Task DeleteAsync(int screenId)
    {
        var response = await Http.DeleteAsync($"/api/hmi/designer/screens/{screenId}");
        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
            return;
        }

        _message = "Screen deleted.";
        _messageIsError = false;
        _selectedScreen = null;
        await RefreshAsync();
    }

    private static string FormatBindingSummary(string? bindingRole, string? sourceKey)
    {
        var roleLabel = NormalizeBindingRole(bindingRole);
        return string.IsNullOrWhiteSpace(sourceKey)
            ? roleLabel
            : $"{roleLabel} → {sourceKey}";
    }

    private static string NormalizeBindingRole(string? bindingRole)
    {
        if (string.IsNullOrWhiteSpace(bindingRole))
        {
            return "Text";
        }

        return bindingRole.Trim() switch
        {
            "PrimaryValue" or "Value" or "Text" => "Text",
            "TextList" => "Text list",
            "Image" => "Image",
            "ImageList" => "Image list",
            "Color" => "Color",
            "Action" => "Action",
            _ => bindingRole.Trim()
        };
    }

