@page "/designer"
@attribute [Authorize(Roles = HmiRoles.Admin)]
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using System.Text
@using System.Text.Json
@using IOTSnap.Hmi.Features.Designer

<PageTitle>Designer</PageTitle>

<section class="page-header">
    <div>
        <div class="hmi-kicker">Designer</div>
        <h2>Screen Configuration</h2>
    </div>
    <p>Create, publish, and inspect screen definitions. Built to be API/MCP compatible.</p>
</section>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice-banner @(_messageIsError ? "notice-banner-error" : string.Empty)">@_message</div>
}

<section class="panel-card">
    <div class="panel-label">Create Screen</div>
    <p>Start with a simple layout and a starter tag to create a publishable screen quickly.</p>
    <div class="hmi-form-grid hmi-form-grid-4">
        <label>
            <span>Name</span>
            <input @bind="_createName" maxlength="128" />
        </label>
        <label>
            <span>Slug</span>
            <input @bind="_createSlug" maxlength="64" />
        </label>
        <label>
            <span>Width</span>
            <input type="number" min="320" step="1" @bind="_createWidth" />
        </label>
        <label>
            <span>Height</span>
            <input type="number" min="240" step="1" @bind="_createHeight" />
        </label>
    </div>

    <div class="hmi-form-grid hmi-form-grid-3">
        <label>
            <span>Starter Tag (optional)</span>
            <select @bind="_selectedNodeId">
                <option value="">None</option>
                @foreach (var tag in _tags)
                {
                    <option value="@tag.NodeId">@tag.DisplayName (@tag.NodeId)</option>
                }
            </select>
        </label>
        <label>
            <span>Widget Type</span>
            <select @bind="_selectedWidgetType">
                @foreach (var widgetType in _widgetTypes)
                {
                    <option value="@widgetType">@widgetType</option>
                }
            </select>
        </label>
        <label>
            <span>Binding Property</span>
            <select @bind="_selectedBindingProperty">
                @foreach (var bindingProperty in _bindingProperties)
                {
                    <option value="@bindingProperty">@bindingProperty</option>
                }
            </select>
        </label>
    </div>
    <p class="setting-value">Bind tags to HMI properties such as Text, Color, Image, Action, or list-based values.</p>

    <div class="button-row">
        <button class="hmi-primary-button" @onclick="CreateScreenAsync">Create</button>
        <button class="hmi-ghost-button" @onclick="RefreshAsync">Refresh</button>
        <button class="hmi-ghost-button" @onclick="ExportCurrentDesignAsync">Export Package</button>
        <label class="hmi-file-picker">
            <span>Import Package</span>
            <InputFile OnChange="OnPackageFileSelectedAsync" accept=".hmi,.json,application/json" />
        </label>
    </div>
</section>

<section class="panel-card">
    <div class="panel-label">Widget Editing</div>
    <p>Switch to edit mode to select a widget and tune its properties from a docked inspector at the bottom of the screen.</p>
    <div class="button-row">
        <button class="hmi-primary-button" @onclick="ToggleEditMode">@(_isEditMode ? "Exit Edit Mode" : "Enter Edit Mode")</button>
        @if (_isEditMode && _selectedEditorWidget is not null)
        {
            <button class="hmi-ghost-button" @onclick="SaveWidgetEditsAsync">Save Edits</button>
        }
    </div>

    @if (_isEditMode)
    {
        <div class="widget-canvas-list">
            @foreach (var widget in _editorWidgets)
            {
                <button type="button" class="widget-canvas-card @(widget.Key == _selectedEditorWidget?.Key ? "widget-canvas-card-active" : string.Empty)" @onclick="() => SelectEditorWidget(widget.Key)">
                    <strong>@widget.Title</strong>
                    <span>@widget.WidgetType · @widget.X,@widget.Y · @widget.Width×@widget.Height</span>
                </button>
            }
        </div>
    }
</section>

<section class="panel-card">
    <div class="panel-label">CSV Tag Import</div>
    <p>Paste CSV with headers like DisplayName, NodeId, Area, DataType, SamplingIntervalMs, IsWritable.</p>
    <div class="inline-action-row">
        <button class="hmi-ghost-button" @onclick="LoadSampleCsvTemplate">Load Sample CSV Template</button>
        <label class="hmi-file-picker">
            <span>Upload CSV</span>
            <InputFile OnChange="OnCsvFileSelectedAsync" accept=".csv,text/csv" />
        </label>
    </div>
    <label class="inline-field">
        <span>CSV Content</span>
        <textarea class="hmi-textarea" rows="8" @bind="_csvContent"></textarea>
    </label>
    <div class="inline-action-row">
        <label class="inline-checkbox">
            <input type="checkbox" @bind="_csvPersist" />
            <span>Persist to node mappings</span>
        </label>
        <button class="hmi-primary-button" @onclick="ImportCsvAsync">Run Import</button>
    </div>

    @if (_csvResult is not null)
    {
        <div class="setting-value">Imported: @_csvResult.Imported, Updated: @_csvResult.Updated, Preview: @_csvResult.PreviewCount, Rejected: @_csvResult.RejectedCount</div>
        @if (_csvResult.Diagnostics.Count > 0)
        {
            <ul class="diag-list">
                @foreach (var diag in _csvResult.Diagnostics)
                {
                    <li class="diag-item @(diag.Severity.Equals("error", StringComparison.OrdinalIgnoreCase) ? "diag-item-error" : "diag-item-warn")">
                        <strong>@diag.Code</strong>: @diag.Message
                        @if (diag.Line.HasValue)
                        {
                            <span>(line @diag.Line.Value)</span>
                        }
                    </li>
                }
            </ul>
        }
    }
</section>

<section class="panel-card">
    <div class="panel-label">Agent Draft Pipeline</div>
    <p>Generate a draft from a prompt or sketch, review it, then apply it safely with optional publishing.</p>
    <div class="hmi-form-grid hmi-form-grid-4">
        <label>
            <span>Name</span>
            <input @bind="_draftName" maxlength="128" />
        </label>
        <label>
            <span>Slug</span>
            <input @bind="_draftSlug" maxlength="64" />
        </label>
        <label>
            <span>Width</span>
            <input type="number" min="320" step="1" @bind="_draftWidth" />
        </label>
        <label>
            <span>Height</span>
            <input type="number" min="240" step="1" @bind="_draftHeight" />
        </label>
    </div>

    <label class="inline-field">
        <span>Prompt</span>
        <input @bind="_draftPrompt" />
    </label>

    <label class="inline-field">
        <span>Sketch JSON (optional)</span>
        <textarea class="hmi-textarea" rows="8" value="@_sketchJson" @oninput="OnSketchJsonInput"></textarea>
    </label>
    @if (!string.IsNullOrWhiteSpace(_sketchJson))
    {
        <div class="sketch-status @(_isSketchJsonValid ? "sketch-status-ok" : "sketch-status-error")">
            @(_isSketchJsonValid ? "Sketch JSON valid." : _sketchValidationMessage)
        </div>
    }

    <div class="inline-action-row">
        <button class="hmi-ghost-button" @onclick="LoadSampleSketchTemplate">Load Sample Sketch Template</button>
        <label class="hmi-file-picker">
            <span>Upload Sketch JSON</span>
            <InputFile OnChange="OnSketchFileSelectedAsync" accept=".json,application/json" />
        </label>
    </div>

    <div class="inline-action-row">
        <label class="inline-checkbox">
            <input type="checkbox" @bind="_allowOverwrite" />
            <span>Allow overwrite on apply</span>
        </label>
        <label class="inline-checkbox">
            <input type="checkbox" @bind="_publishOnApply" />
            <span>Publish on apply</span>
        </label>
    </div>

    <div class="button-row">
        <button class="hmi-primary-button" @onclick="GenerateDraftAsync">Generate Draft</button>
        <button class="hmi-ghost-button" @onclick="GenerateFromSketchAsync">Generate From Sketch</button>
        <button class="hmi-ghost-button" @onclick="PreviewDraftAsync">Preview Draft</button>
        <button class="hmi-primary-button" @onclick="ApplyDraftSafeAsync">Apply Draft Safe</button>
        @if (_draft is not null)
        {
            <button class="hmi-ghost-button" @onclick="DownloadDraftJsonAsync">Download Draft JSON</button>
        }
        @if (_rollbackDraft is not null)
        {
            <button class="hmi-ghost-button" @onclick="RollbackLastApplyAsync">Rollback Last Apply</button>
        }
    </div>

    @if (_draftMetadata is not null)
    {
        <div class="setting-value">DraftHash: @_draftMetadata.DraftHash</div>
        <div class="setting-value">ApplyToken: @_draftMetadata.ApplyToken</div>
        <div class="setting-value">WidgetCount: @_draftMetadata.WidgetCount</div>
    }
    else if (_draft is not null)
    {
        <div class="setting-value">Draft is ready for preview or safe application.</div>
    }

    @if (_previewResult is not null)
    {
        <div class="setting-value">CanApply: @(_previewResult.CanApply ? "Yes" : "No")</div>
    }

    @if (_draftDiagnostics.Count > 0)
    {
        <ul class="diag-list">
            @foreach (var diag in _draftDiagnostics)
            {
                <li class="diag-item @(diag.Severity.Equals("error", StringComparison.OrdinalIgnoreCase) ? "diag-item-error" : "diag-item-warn")">
                    <strong>@diag.Code</strong>: @diag.Message
                    @if (diag.Line.HasValue)
                    {
                        <span>(line @diag.Line.Value)</span>
                    }
                </li>
            }
        </ul>
    }

    @if (_draft is not null)
    {
        <table class="hmi-table">
            <thead>
                <tr>
                    <th>Widget</th>
                    <th>Type</th>
                    <th>Position</th>
                    <th>Bindings</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var widget in _draft.Widgets)
                {
                    <tr>
                        <td>@widget.Title</td>
                        <td>@widget.WidgetType</td>
                        <td>@widget.X,@widget.Y @widget.Width x @widget.Height</td>
                        <td>@string.Join(" • ", widget.Bindings.Select(x => FormatBindingSummary(x.BindingRole, x.SourceKey)))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="panel-card">
    <div class="panel-label">Existing Screens</div>
    <p>Publish a screen to make it available to the runtime renderer and operator view.</p>
    <table class="hmi-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Slug</th>
                <th>Widgets</th>
                <th>Published</th>
                <th>Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_screens.Count == 0)
            {
                <tr>
                    <td colspan="6">No screens defined.</td>
                </tr>
            }
            else
            {
                @foreach (var screen in _screens)
                {
                    <tr>
                        <td>@screen.Name</td>
                        <td>@screen.Slug</td>
                        <td>@screen.WidgetCount</td>
                        <td>@(screen.IsPublished ? "Yes" : "No")</td>
                        <td>@screen.UpdatedUtc.ToString("u")</td>
                        <td>
                            <div class="table-action-stack">
                                <button class="hmi-ghost-button" @onclick="() => LoadScreenDetailsAsync(screen.Slug)">Inspect</button>
                                <button class="hmi-primary-button" @onclick="() => PublishAsync(screen.Id)">Publish</button>
                                @if (screen.IsPublished)
                                {
                                    <button class="hmi-ghost-button" @onclick="() => OpenRuntimeAsync(screen.Slug)">Open Runtime</button>
                                }
                                <button class="hmi-ghost-button" @onclick="() => DeleteAsync(screen.Id)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

@if (_isEditMode && _selectedEditorWidget is not null)
{
    <div class="property-editor-dock">
        <section class="panel-card property-editor-card">
            <div class="panel-label">Property Editor</div>
            <p>Edit the selected widget as if you were tuning an HMI object in a live editor.</p>
            <div class="hmi-form-grid hmi-form-grid-4">
                <label>
                    <span>Title</span>
                    <input @bind="_selectedEditorWidget.Title" />
                </label>
                <label>
                    <span>Type</span>
                    <select @bind="_selectedEditorWidget.WidgetType">
                        @foreach (var widgetType in _widgetTypes)
                        {
                            <option value="@widgetType">@widgetType</option>
                        }
                    </select>
                </label>
                <label>
                    <span>X</span>
                    <input type="number" @bind="_selectedEditorWidget.X" />
                </label>
                <label>
                    <span>Y</span>
                    <input type="number" @bind="_selectedEditorWidget.Y" />
                </label>
            </div>
            <div class="hmi-form-grid hmi-form-grid-4">
                <label>
                    <span>Width</span>
                    <input type="number" @bind="_selectedEditorWidget.Width" />
                </label>
                <label>
                    <span>Height</span>
                    <input type="number" @bind="_selectedEditorWidget.Height" />
                </label>
                <label>
                    <span>Z</span>
                    <input type="number" @bind="_selectedEditorWidget.ZIndex" />
                </label>
                <label>
                    <span>Property JSON</span>
                    <input @bind="_selectedEditorWidget.PropertiesJson" />
                </label>
            </div>
            <div class="hmi-form-grid hmi-form-grid-4">
                <label>
                    <span>Property</span>
                    <input @bind="_selectedEditorWidget.Properties.Property" />
                </label>
                <label>
                    <span>Unit</span>
                    <input @bind="_selectedEditorWidget.Properties.Unit" />
                </label>
                <label>
                    <span>Scale</span>
                    <input type="number" step="0.01" @bind="_selectedEditorWidget.Properties.DisplayScale" />
                </label>
                <label>
                    <span>Offset</span>
                    <input type="number" step="0.01" @bind="_selectedEditorWidget.Properties.DisplayOffset" />
                </label>
            </div>
            <div class="hmi-form-grid hmi-form-grid-4">
                <label>
                    <span>Decimal Places</span>
                    <input type="number" min="0" @bind="_selectedEditorWidget.Properties.DecimalPlaces" />
                </label>
                <label>
                    <span>Value Min</span>
                    <input type="number" step="0.01" @bind="_selectedEditorWidget.Properties.ValueMin" />
                </label>
                <label>
                    <span>Value Max</span>
                    <input type="number" step="0.01" @bind="_selectedEditorWidget.Properties.ValueMax" />
                </label>
                <label>
                    <span>Input Step</span>
                    <input type="number" step="0.01" @bind="_selectedEditorWidget.Properties.InputStep" />
                </label>
            </div>
            <div class="hmi-form-grid hmi-form-grid-4">
                <label>
                    <span>Input Min</span>
                    <input type="number" step="0.01" @bind="_selectedEditorWidget.Properties.InputMin" />
                </label>
                <label>
                    <span>Input Max</span>
                    <input type="number" step="0.01" @bind="_selectedEditorWidget.Properties.InputMax" />
                </label>
                <label>
                    <span>Input Mode</span>
                    <input @bind="_selectedEditorWidget.Properties.InputMode" />
                </label>
                <label>
                    <span>Input Label</span>
                    <input @bind="_selectedEditorWidget.Properties.InputLabel" />
                </label>
            </div>

            <div class="binding-editor-list">
                <div class="inline-action-row">
                    <strong>Bindings</strong>
                    <button class="hmi-ghost-button" type="button" @onclick="AddBindingToSelectedWidget">Add Binding</button>
                </div>
                @foreach (var binding in _selectedEditorWidget.Bindings)
                {
                    <div class="binding-editor-row">
                        <label>
                            <span>Role</span>
                            <select @bind="binding.BindingRole">
                                <option value="Text">Text</option>
                                <option value="TextList">TextList</option>
                                <option value="Image">Image</option>
                                <option value="ImageList">ImageList</option>
                                <option value="Color">Color</option>
                                <option value="Action">Action</option>
                            </select>
                        </label>
                        <label>
                            <span>Source</span>
                            <input @bind="binding.SourceKey" />
                        </label>
                        <label>
                            <span>Min Role</span>
                            <select @bind="binding.MinRole">
                                <option value="Viewer">Viewer</option>
                                <option value="Operator">Operator</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </label>
                        <label class="inline-checkbox">
                            <input type="checkbox" @bind="binding.WriteRequiresConfirm" />
                            <span>Confirm write</span>
                        </label>
                    </div>
                }
            </div>
        </section>
    </div>
}

@if (_selectedScreen is not null)
{
    <section class="panel-card">
        <div class="panel-label">Screen Detail: @_selectedScreen.Name (@_selectedScreen.Slug)</div>
        <table class="hmi-table">
            <thead>
                <tr>
                    <th>Widget</th>
                    <th>Type</th>
                    <th>Position</th>
                    <th>Bindings</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var widget in _selectedScreen.Widgets)
                {
                    <tr>
                        <td>@widget.Title</td>
                        <td>@widget.WidgetType</td>
                        <td>@widget.X,@widget.Y @widget.Width x @widget.Height</td>
                        <td>
                            @foreach (var binding in widget.Bindings)
                            {
                                <div>@FormatBindingSummary(binding.BindingRole, binding.SourceKey) <span class="binding-role-caption">(@binding.MinRole)</span></div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private string? _message;
    private bool _messageIsError;

    private string _createName = "";
    private string _createSlug = "";
    private int _createWidth = 1366;
    private int _createHeight = 768;
    private string _selectedNodeId = string.Empty;
    private string _selectedWidgetType = "Numeric";
    private string _selectedBindingProperty = "Text";
    private IReadOnlyList<string> _bindingProperties = ["Text", "TextList", "Image", "ImageList", "Color", "Action"];
    private string _csvContent = string.Empty;
    private bool _csvPersist;
    private CsvImportResponseDto? _csvResult;

    private string _draftName = "AI Draft";
    private string _draftSlug = "ai-draft";
    private int _draftWidth = 1366;
    private int _draftHeight = 768;
    private string _draftPrompt = string.Empty;
    private string _sketchJson = string.Empty;
    private bool _isSketchJsonValid = true;
    private string _sketchValidationMessage = string.Empty;
    private bool _allowOverwrite;
    private bool _publishOnApply;
    private DraftScreenDto? _draft;
    private DraftMetadataDto? _draftMetadata;
    private DraftPreviewResponseDto? _previewResult;
    private List<ApiDiagnosticDto> _draftDiagnostics = new();
    private DraftScreenDto? _rollbackDraft;
    private bool _rollbackWasPublished;

    private bool _isEditMode;
    private WidgetEditorItem? _selectedEditorWidget;
    private List<WidgetEditorItem> _editorWidgets = new();

    private IReadOnlyList<string> _widgetTypes = ["Numeric", "CommandButton", "TrendChart"];
    private IReadOnlyList<TagCatalogItemDto> _tags = Array.Empty<TagCatalogItemDto>();
    private IReadOnlyList<ScreenSummaryDto> _screens = Array.Empty<ScreenSummaryDto>();
    private ScreenDetailDto? _selectedScreen;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        await Task.WhenAll(LoadScreensAsync(), LoadTagCatalogAsync(), LoadCapabilitiesAsync());
    }

    private async Task LoadCapabilitiesAsync()
    {
        try
        {
            var capabilities = await Http.GetFromJsonAsync<CapabilitiesDto>("/api/hmi/agent/capabilities");
            if (capabilities is not null && capabilities.SupportedWidgetTypes.Count > 0)
            {
                _widgetTypes = capabilities.SupportedWidgetTypes;
                if (!_widgetTypes.Contains(_selectedWidgetType, StringComparer.OrdinalIgnoreCase))
                {
                    _selectedWidgetType = _widgetTypes[0];
                }
            }
        }
        catch
        {
            // Keep local defaults if capabilities endpoint is unavailable.
        }
    }

    private async Task LoadTagCatalogAsync()
    {
        _tags = await Http.GetFromJsonAsync<List<TagCatalogItemDto>>("/api/hmi/agent/tag-catalog")
            ?? new List<TagCatalogItemDto>();
    }

    private async Task ExportCurrentDesignAsync()
    {
        var package = BuildPackageFromCurrentSelection();
        var archiveBytes = HmiProjectPackageSerializer.CreateArchive(package);
        await using var stream = new MemoryStream(archiveBytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("hmiDownloadFile", $"{package.Screen.Slug ?? "design"}.hmi", streamRef);
        _message = "HMI package exported.";
        _messageIsError = false;
    }

    private async Task OnPackageFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await using var stream = file.OpenReadStream(8 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var package = TryLoadPackage(memory.ToArray());
        if (package is null)
        {
            _message = "The selected file is not a valid HMI package.";
            _messageIsError = true;
            return;
        }

        _createName = package.Screen.Name;
        _createSlug = package.Screen.Slug;
        _createWidth = package.Screen.Width;
        _createHeight = package.Screen.Height;
        _draftName = package.Screen.Name;
        _draftSlug = package.Screen.Slug;
        _draftWidth = package.Screen.Width;
        _draftHeight = package.Screen.Height;
        _draft = new DraftScreenDto(
            package.Screen.Name,
            package.Screen.Slug,
            package.Screen.Width,
            package.Screen.Height,
            string.Empty,
            string.Empty,
            package.Screen.Widgets.Select(ToDraftWidgetDtoFromPackage).ToList());
        _selectedScreen = null;
        _message = "HMI package imported. Review and apply it from the draft pipeline.";
        _messageIsError = false;
    }

    private static HmiProjectPackage? TryLoadPackage(byte[] packageBytes)
    {
        try
        {
            var json = Encoding.UTF8.GetString(packageBytes);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var package = HmiProjectPackageSerializer.Deserialize(json);
                if (package is not null)
                {
                    return package;
                }
            }
        }
        catch (JsonException)
        {
            // Fall back to archive-based packaging.
        }

        try
        {
            return HmiProjectPackageSerializer.ReadArchive(packageBytes);
        }
        catch (InvalidDataException)
        {
            return null;
        }
        catch (IOException)
        {
            return null;
        }
    }

    private async Task LoadScreensAsync()
    {
        _screens = await Http.GetFromJsonAsync<List<ScreenSummaryDto>>("/api/hmi/designer/screens")
            ?? new List<ScreenSummaryDto>();
    }

    private async Task LoadScreenDetailsAsync(string slug)
    {
        _selectedScreen = await Http.GetFromJsonAsync<ScreenDetailDto>($"/api/hmi/designer/screens/{slug}");
        SyncEditorWidgetsFromCurrentSelection();
    }

    private async Task ImportCsvAsync()
    {
        _message = null;
        _messageIsError = false;

        var response = await Http.PostAsJsonAsync("/api/hmi/agent/import-tags-csv", new CsvImportRequestDto(_csvContent, _csvPersist, null));
        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
            return;
        }

        _csvResult = await response.Content.ReadFromJsonAsync<CsvImportResponseDto>();
        _message = _csvPersist ? "CSV import completed." : "CSV preview completed.";
        _messageIsError = false;
        await RefreshAsync();
    }

    private void LoadSampleCsvTemplate()
    {
        _csvContent =
            "DisplayName,NodeId,Area,DataType,SamplingIntervalMs,IsWritable\n"
            + "Tank Level,ns=2;s=Plant.Tank.Level,Process,double,1000,false\n"
            + "Line Speed,ns=2;s=Plant.Line.Speed,Process,double,500,false\n"
            + "Start Command,ns=2;s=Plant.Line.Start,Commands,bool,250,true\n";
    }

    private async Task OnCsvFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        _csvContent = await reader.ReadToEndAsync();
    }

    private async Task GenerateDraftAsync()
    {
        _message = null;
        _messageIsError = false;

        var sketch = ParseSketchJsonOrNull();
        if (_messageIsError)
        {
            return;
        }

        var response = await Http.PostAsJsonAsync("/api/hmi/agent/draft-screen", new DraftScreenRequestDto(
            _draftName,
            _draftSlug,
            _draftWidth,
            _draftHeight,
            _draftPrompt,
            sketch?.Notes,
            sketch,
            null));

        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
            return;
        }

        _draft = await response.Content.ReadFromJsonAsync<DraftScreenDto>();
        _draftMetadata = null;
        _previewResult = null;
        _draftDiagnostics.Clear();
        SyncEditorWidgetsFromCurrentSelection();
        _message = "Draft generated.";
    }

    private async Task GenerateFromSketchAsync()
    {
        _message = null;
        _messageIsError = false;

        var sketch = ParseSketchJsonOrNull();
        if (sketch is null)
        {
            _message = "Sketch JSON is required for sketch synthesis.";
            _messageIsError = true;
            return;
        }

        var response = await Http.PostAsJsonAsync("/api/hmi/agent/sketch-intake", new SketchIntakeRequestDto(
            _draftName,
            _draftSlug,
            _draftWidth,
            _draftHeight,
            _draftPrompt,
            sketch,
            24));

        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<SketchIntakeResponseDto>();
        if (result is null)
        {
            _message = "No sketch response payload returned.";
            _messageIsError = true;
            return;
        }

        _draft = result.Draft;
        _draftMetadata = result.Metadata;
        _draftDiagnostics = result.Diagnostics.ToList();
        _previewResult = null;
        SyncEditorWidgetsFromCurrentSelection();
        _message = "Sketch draft generated.";
    }

