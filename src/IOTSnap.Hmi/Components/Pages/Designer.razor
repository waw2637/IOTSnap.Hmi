    private async Task OnSketchFileSelectedAsync(InputFileChangeEventArgs e)
        {
        var file = e.File;
        await using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        _sketchJson = await reader.ReadToEndAsync();
        ValidateSketchJson();
    }

    private void OnSketchJsonInput(ChangeEventArgs e)
    {
        _sketchJson = e.Value?.ToString() ?? string.Empty;
        ValidateSketchJson();
    }

    private void ValidateSketchJson()
    {
        _isSketchJsonValid = true;
        _sketchValidationMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_sketchJson))
        {
            return;
        }

        try
        {
            var sketch = JsonSerializer.Deserialize<SketchLayoutInputDto>(_sketchJson, new JsonSerializerOptions(JsonSerializerDefaults.Web)
            {
                PropertyNameCaseInsensitive = true
            });

            if (sketch is null)
            {
                _isSketchJsonValid = false;
                _sketchValidationMessage = "Sketch JSON parsed as null.";
            }
        }
        catch (Exception ex)
        {
            _isSketchJsonValid = false;
            _sketchValidationMessage = $"Invalid sketch JSON: {ex.Message}";
        }
        }

    private async Task PreviewDraftAsync()
    {
        _message = null;
        _messageIsError = false;

        if (_draft is null)
        {
            _message = "Generate a draft first.";
            _messageIsError = true;
            return;
        }

        var response = await Http.PostAsJsonAsync("/api/hmi/agent/draft-preview", new DraftPreviewRequestDto(_draft, _allowOverwrite));
        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
            return;
        }

        var preview = await response.Content.ReadFromJsonAsync<DraftPreviewResponseDto>();
        if (preview is null)
        {
            _message = "No preview payload returned.";
            _messageIsError = true;
            return;
        }

        _previewResult = preview;
        _draft = preview.Draft;
        _draftMetadata = preview.Metadata;
        _draftDiagnostics = preview.Diagnostics.ToList();
        SyncEditorWidgetsFromCurrentSelection();
        _message = "Draft preview ready.";
    }

    private async Task ApplyDraftSafeAsync()
    {
        _message = null;
        _messageIsError = false;

        if (_draft is null)
        {
            _message = "Generate and preview a draft first.";
            _messageIsError = true;
            return;
        }

        var expectedHash = _draftMetadata?.DraftHash;
        var response = await Http.PostAsJsonAsync("/api/hmi/agent/apply-draft-safe", new ApplyDraftRequestDto(
            _draft,
            expectedHash,
            _allowOverwrite,
            _publishOnApply));

        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
            return;
        }

        var apply = await response.Content.ReadFromJsonAsync<ApplyDraftResponseDto>();
        if (apply?.Rollback?.Draft is not null)
        {
            _rollbackDraft = apply.Rollback.Draft;
            _rollbackWasPublished = apply.Rollback.WasPublished;
        }

        _message = "Draft applied successfully.";
        _messageIsError = false;
        await RefreshAsync();
    }

    private async Task RollbackLastApplyAsync()
    {
        _message = null;
        _messageIsError = false;

        if (_rollbackDraft is null)
        {
            _message = "No rollback snapshot available.";
            _messageIsError = true;
            return;
        }

        var response = await Http.PostAsJsonAsync("/api/hmi/agent/apply-draft-safe", new ApplyDraftRequestDto(
            _rollbackDraft,
            null,
            true,
            _rollbackWasPublished));

        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
            return;
        }

        _message = "Rollback applied.";
        _messageIsError = false;
        await RefreshAsync();
    }

    private SketchLayoutInputDto? ParseSketchJsonOrNull()
    {
        if (string.IsNullOrWhiteSpace(_sketchJson))
        {
            return null;
        }

        ValidateSketchJson();
        if (!_isSketchJsonValid)
        {
            _message = _sketchValidationMessage;
            _messageIsError = true;
            return null;
        }

        try
        {
            var sketch = JsonSerializer.Deserialize<SketchLayoutInputDto>(_sketchJson, new JsonSerializerOptions(JsonSerializerDefaults.Web)
            {
                PropertyNameCaseInsensitive = true
            });

            if (sketch is null)
            {
                _message = "Sketch JSON parsed as null.";
                _messageIsError = true;
                return null;
            }

            return sketch;
        }
        catch (Exception ex)
        {
            _message = $"Invalid sketch JSON: {ex.Message}";
            _messageIsError = true;
            return null;
        }
    }

    private async Task DownloadDraftJsonAsync()
    {
        _message = null;
        _messageIsError = false;

        if (_draft is null)
        {
            _message = "No draft available to download.";
            _messageIsError = true;
            return;
        }

        var json = JsonSerializer.Serialize(_draft, new JsonSerializerOptions(JsonSerializerDefaults.Web)
        {
            WriteIndented = true
        });

        await using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(json));
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("hmiDownloadFile", $"{_draft.Slug}.draft.json", streamRef);
        _message = "Draft JSON downloaded.";
    }

    private async Task CreateScreenAsync()
    {
        _message = null;
        _messageIsError = false;

        var bindings = new List<WidgetBindingDto>();
        if (!string.IsNullOrWhiteSpace(_selectedNodeId))
        {
            bindings.Add(new WidgetBindingDto(_selectedBindingProperty, "OpcTag", _selectedNodeId, false, HmiRoles.Viewer));
        }

        var payload = new CreateScreenRequest(
            _createName,
            _createSlug,
            _createWidth,
            _createHeight,
            [new WidgetUpsertDto("starter-1", _selectedWidgetType, "Starter Widget", 40, 40, 320, 160, 1, "{}", bindings)]);

        var response = await Http.PostAsJsonAsync("/api/hmi/designer/screens", payload);
        if (!response.IsSuccessStatusCode)
        {
            _message = await response.Content.ReadAsStringAsync();
            _messageIsError = true;
            return;
        }

        _message = "Screen created.";
        await RefreshAsync();
    }

    private void ToggleEditMode()
    {
        _isEditMode = !_isEditMode;
        SyncEditorWidgetsFromCurrentSelection();
