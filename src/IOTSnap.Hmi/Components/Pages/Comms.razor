@page "/comms"
@attribute [Authorize]
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<HmiDbContext> DbContextFactory
@inject IOpcUaRuntime OpcUaRuntime
@inject IOpcUaDiscovery OpcUaDiscovery
@inject IOpcUaCertificateStore OpcUaCertificateStore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtectionProvider
@inject RuntimeAuditService AuditService
@using IOTSnap.Hmi.Features.Designer
@implements IAsyncDisposable

<PageTitle>Communications</PageTitle>

<section class="page-header">
    <div>
        <div class="hmi-kicker">OPC UA</div>
        <h2>Communications</h2>
    </div>
    <p>Configure the active OPC UA endpoint and node mappings used by the local runtime.</p>
</section>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice-banner @(_messageIsError ? "notice-banner-error" : string.Empty)">
        @_message
    </div>
}

<section class="dashboard-grid">
    <article class="panel-card">
        <div class="panel-label">Connection Status</div>
        <div class="panel-metric panel-metric-sm">@(_runtimeStatus.IsConnected ? "Connected" : "Pending")</div>
        <p>@_runtimeStatus.Detail</p>
    </article>

    <article class="panel-card">
        <div class="panel-label">Endpoint</div>
        <div class="setting-key">@_profile?.EndpointUrl</div>
        <p>@_profile?.SecurityMode / @_profile?.SecurityPolicy</p>
    </article>

    <article class="panel-card">
        <div class="panel-label">Auth Mode</div>
        <div class="panel-metric panel-metric-sm">@_profile?.AuthenticationMode</div>
        <p>Publishing interval: @_profile?.PublishingIntervalMs ms</p>
    </article>

    <article class="panel-card">
        <div class="panel-label">Configured Nodes</div>
        <div class="panel-metric">@_nodes.Count</div>
        <p>Write support should be added only after explicit authorization rules are in place.</p>
    </article>

    <article class="panel-card">
        <div class="panel-label">Alarmed Tags</div>
        <div class="panel-metric">@_alarmedTagCount</div>
        <p>Tags with bad quality or stale values.</p>
    </article>

    <article class="panel-card">
        <div class="panel-label">Stale Tags</div>
        <div class="panel-metric">@_staleTagCount</div>
        <p>No update within expected interval window.</p>
    </article>

    <article class="panel-card">
        <div class="panel-label">Active Alarms</div>
        <div class="panel-metric">@_activeAlarmCount</div>
        <p>Persisted alarm records in active state.</p>
    </article>

    <article class="panel-card">
        <div class="panel-label">Unacknowledged</div>
        <div class="panel-metric">@_unacknowledgedAlarmCount</div>
        <p>Require operator/admin acknowledgement.</p>
    </article>
</section>

<section class="panel-card">
    <div class="panel-label">Trusted Certificates</div>
    <p>Import trusted application or issuer certificates into the local HMI trust store without shell access.</p>
    <div class="hmi-form-grid hmi-form-grid-2">
        <label>
            <span>Trust Store</span>
            <select @bind="_certificateImportTarget">
                <option value="@nameof(OpcUaTrustStoreKind.ApplicationPeer)">Trusted Application</option>
                <option value="@nameof(OpcUaTrustStoreKind.IssuerAuthority)">Trusted Issuer</option>
            </select>
        </label>
        <label>
            <span>Certificate File</span>
            <InputFile OnChange="OnTrustedCertificateSelectedAsync" accept=".cer,.crt,.der,.pem,application/x-x509-ca-cert" disabled="@_isImportingCertificate" />
        </label>
    </div>

    @if (_trustedCertificates.Count > 0)
    {
        <table class="hmi-table">
            <thead>
                <tr>
                    <th>Store</th>
                    <th>Subject</th>
                    <th>Thumbprint</th>
                    <th>Imported</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var certificate in _trustedCertificates)
                {
                    <tr>
                        <td>@DescribeTrustStore(certificate.TrustKind)</td>
                        <td>@certificate.Subject</td>
                        <td>@certificate.Thumbprint</td>
                        <td>@certificate.ImportedUtc.ToLocalTime().ToString("u")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="panel-card">
    <div class="panel-label">Connection Actions</div>
    <div class="button-row">
        <button class="hmi-primary-button" @onclick="RefreshConnectionAsync">Refresh Connection</button>
        <button class="hmi-ghost-button" @onclick="() => ToggleProfileEnabledAsync(_profile?.Enabled != true)">
            @(_profile?.Enabled == true ? "Disable Profile" : "Enable Profile")
        </button>
    </div>
    <ul class="diag-list">
        <li class="diag-item">Use a reachable opc.tcp endpoint for a real PLC or keep the seeded demo profile for a local walkthrough.</li>
        <li class="diag-item">Enable the profile only after the endpoint and credentials are verified.</li>
        <li class="diag-item">Refresh the connection after changing the endpoint, security options, or mapped nodes.</li>
    </ul>
</section>

<section class="panel-card">
    <div class="panel-label">Server Discovery</div>
    <p>Discover reachable OPC UA endpoints and browse their tags before applying a profile.</p>
    <div class="hmi-form-grid hmi-form-grid-3">
        <label>
            <span>Discovery URL</span>
            <input @bind="_discoveryUrl" maxlength="512" placeholder="opc.tcp://192.168.1.26:50000" />
        </label>
        <label>
            <span>Auth Mode For Browse</span>
            <select @bind="_discoveryAuthenticationMode">
                <option value="Anonymous">Anonymous</option>
                <option value="UsernamePassword">UsernamePassword</option>
            </select>
        </label>
        <label>
            <span>Browse Depth</span>
            <input type="number" min="1" max="12" step="1" @bind="_browseDepth" />
        </label>
    </div>
    @if (_discoveryAuthenticationMode == "UsernamePassword")
    {
        <div class="hmi-form-grid hmi-form-grid-2">
            <label>
                <span>Browse Username</span>
                <input @bind="_discoveryUsername" maxlength="128" />
            </label>
            <label>
                <span>Browse Password</span>
                <input type="password" @bind="_discoveryPassword" />
            </label>
        </div>
    }
    <div class="button-row">
        <button class="hmi-primary-button" @onclick="DiscoverEndpointsAsync" disabled="@_isDiscovering">Discover Endpoints</button>
        <button class="hmi-ghost-button" @onclick="BrowseSelectedEndpointAsync" disabled="@(_selectedDiscoveredEndpoint is null || _isBrowsingTags)">Browse Tags</button>
    </div>

    @if (_discoveredEndpoints.Count > 0)
    {
        <table class="hmi-table">
            <thead>
                <tr>
                    <th>Endpoint</th>
                    <th>Server</th>
                    <th>Security</th>
                    <th>Auth</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var endpoint in _discoveredEndpoints)
                {
                    <tr class="@(ReferenceEquals(_selectedDiscoveredEndpoint, endpoint) ? "selected-row" : string.Empty)">
                        <td>@endpoint.EndpointUrl</td>
                        <td>@endpoint.ApplicationName</td>
                        <td>@endpoint.SecurityMode / @endpoint.SecurityPolicy</td>
                        <td>@DescribeAuth(endpoint)</td>
                        <td>
                            <div class="inline-action-row">
                                <button class="hmi-ghost-button" @onclick="() => SelectDiscoveredEndpoint(endpoint)">Select</button>
                                <button class="hmi-primary-button" @onclick="() => ApplyDiscoveredEndpoint(endpoint)">Apply</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_discoveredTags.Count > 0)
    {
        <div class="setting-value">Browsable tags from @(_selectedDiscoveredEndpoint?.EndpointUrl ?? _discoveryUrl)</div>
        <table class="hmi-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>NodeId</th>
                    <th>Path</th>
                    <th>Type</th>
                    <th>Writable</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tag in _discoveredTags)
                {
                    <tr>
                        <td>@tag.DisplayName</td>
                        <td>@tag.NodeId</td>
                        <td>@tag.BrowsePath</td>
                        <td>@tag.DataType</td>
                        <td>@(tag.IsWritable ? "Yes" : "No")</td>
                        <td>
                            <button class="hmi-ghost-button" @onclick="() => StageDiscoveredTag(tag)">Stage Mapping</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="panel-card">
    <div class="panel-label">Connection Profile</div>
    @if (_profile is null)
    {
        <p>No profile configured.</p>
    }
    else
    {
        <div class="hmi-form-grid hmi-form-grid-3">
            <label>
                <span>Name</span>
                <input @bind="_profile.Name" maxlength="128" />
            </label>
            <label>
                <span>Endpoint URL</span>
                <input @bind="_profile.EndpointUrl" maxlength="512" />
            </label>
            <label>
                <span>Auth Mode</span>
                <select @bind="_profile.AuthenticationMode">
                    <option value="Anonymous">Anonymous</option>
                    <option value="UsernamePassword">UsernamePassword</option>
                </select>
            </label>
            <label>
                <span>Security Policy</span>
                <input @bind="_profile.SecurityPolicy" maxlength="64" />
            </label>
            <label>
                <span>Security Mode</span>
                <input @bind="_profile.SecurityMode" maxlength="64" />
            </label>
            <label>
                <span>Publishing Interval (ms)</span>
                <input type="number" min="100" step="100" @bind="_profile.PublishingIntervalMs" />
            </label>
        </div>
        <div class="hmi-form-grid hmi-form-grid-2">
            <label>
                <span>Username</span>
                <input @bind="_profile.Username" maxlength="128" />
            </label>
            <label>
                <span>Password</span>
                <input type="password" @bind="_profile.Password" />
            </label>
        </div>
        <div class="inline-action-row">
            <label class="inline-checkbox">
                <input type="checkbox" @bind="_profile.Enabled" />
                <span>Enabled</span>
            </label>
            <label class="inline-checkbox">
                <input type="checkbox" @bind="_profile.UseSecurity" />
                <span>Use Security</span>
            </label>
        </div>
        <div class="button-row">
            <button class="hmi-primary-button" @onclick="SaveProfileAsync">Save Profile</button>
        </div>
    }
</section>

<section class="panel-card">
    <div class="panel-label">Alarm State</div>
    <table class="hmi-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>NodeId</th>
                <th>State</th>
                <th>Alarm</th>
                <th>Last Raised</th>
                <th>Acknowledged</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_alarms.Count == 0)
            {
                <tr>
                    <td colspan="7">No alarm records.</td>
                </tr>
            }
            else
            {
                @foreach (var alarm in _alarms)
                {
                    <tr>
                        <td>@alarm.DisplayName</td>
                        <td>@alarm.NodeId</td>
                        <td>
                            @if (alarm.IsActive)
                            {
                                <span class="alarm-chip">Active</span>
                            }
                            else
                            {
                                <span>Cleared</span>
                            }
                        </td>
                        <td>@alarm.AlarmText</td>
                        <td>@alarm.LastRaisedUtc.ToString("u")</td>
                        <td>
                            @if (alarm.IsAcknowledged)
                            {
                                <span>@(alarm.AcknowledgedBy ?? "unknown") @alarm.AcknowledgedUtc?.ToString("u")</span>
                            }
                            else
                            {
                                <span>Not acknowledged</span>
                            }
                        </td>
                        <td>
                            @if (!_canAcknowledge)
                            {
                                <span>Read only role</span>
                            }
                            else if (alarm.IsAcknowledged)
                            {
                                <span>Acknowledged</span>
                            }
                            else
                            {
                                <button class="hmi-primary-button" @onclick="() => AcknowledgeAlarmAsync(alarm.NodeId)">Acknowledge</button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

<section class="panel-card">
    <div class="panel-label">Add Node Mapping</div>
    <div class="hmi-form-grid hmi-form-grid-4">
        <label>
            <span>Display Name</span>
            <input @bind="_newNode.DisplayName" maxlength="128" />
        </label>
        <label>
            <span>NodeId</span>
            <input @bind="_newNode.NodeId" maxlength="256" />
        </label>
        <label>
            <span>Area</span>
            <input @bind="_newNode.Area" maxlength="64" />
        </label>
        <label>
            <span>Data Type</span>
            <input @bind="_newNode.DataType" maxlength="32" />
        </label>
    </div>
    <div class="hmi-form-grid hmi-form-grid-2">
        <label>
            <span>Sampling Interval (ms)</span>
            <input type="number" min="100" step="100" @bind="_newNode.SamplingIntervalMs" />
        </label>
        <label class="inline-checkbox">
            <input type="checkbox" @bind="_newNode.IsWritable" />
            <span>Writable</span>
        </label>
    </div>
    <div class="button-row">
        <button class="hmi-primary-button" @onclick="AddNodeAsync">Add Node</button>
    </div>
</section>

<section class="panel-card">
    <div class="panel-label">Mapped Nodes</div>
    <table class="hmi-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>NodeId</th>
                <th>Area</th>
                <th>Type</th>
                <th>Writable</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_nodes.Count == 0)
            {
                <tr>
                    <td colspan="6">No nodes configured.</td>
                </tr>
            }
            else
            {
                @foreach (var node in _nodes)
                {
                    <tr>
                        <td>@node.DisplayName</td>
                        <td>@node.NodeId</td>
                        <td>@node.Area</td>
                        <td>@node.DataType</td>
                        <td>@(node.IsWritable ? "Yes" : "No")</td>
                        <td>
                            <button class="hmi-ghost-button" @onclick="() => DeleteNodeAsync(node.Id)">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

<section class="panel-card">
    <div class="panel-label">Live Subscribed Values</div>
    <table class="hmi-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>NodeId</th>
                <th>Value</th>
                <th>Status</th>
                <th>Source Time (UTC)</th>
                <th>Updated (UTC)</th>
                <th>Alarm</th>
                <th>Write</th>
            </tr>
        </thead>
        <tbody>
            @if (_tagSnapshots.Count == 0)
            {
                <tr>
                    <td colspan="8">No live values yet. Confirm connection and mapped nodes.</td>
                </tr>
            }
            else
            {
                @foreach (var tag in _tagSnapshots)
                {
                    <tr>
                        <td>@tag.DisplayName</td>
                        <td>@tag.NodeId</td>
                        <td>@(string.IsNullOrWhiteSpace(tag.ValueText) ? "(null)" : tag.ValueText)</td>
                        <td>@tag.StatusCode</td>
                        <td>@(tag.SourceTimestampUtc?.ToString("u") ?? "n/a")</td>
                        <td>@tag.UpdatedUtc.ToString("u")</td>
                        <td>
                            @if (tag.HasAlarm)
                            {
                                <span class="alarm-chip">@tag.AlarmText</span>
                            }
                            else
                            {
                                <span>OK</span>
                            }
                        </td>
                        <td>
                            @if (!_canWrite)
                            {
                                <span>Read only role</span>
                            }
                            else if (!tag.IsWritable)
                            {
                                <span>Read only tag</span>
                            }
                            else
                            {
                                <div class="inline-action-row">
                                    <input
                                        class="hmi-write-input"
                                        value="@GetPendingWriteValue(tag)"
                                        @oninput="e => SetPendingWriteValue(tag.NodeId, e.Value?.ToString() ?? string.Empty)" />
                                    <button class="hmi-primary-button" @onclick="() => WriteTagAsync(tag)">Write</button>
                                </div>
                                @if (_writeResults.TryGetValue(tag.NodeId, out var writeResult))
                                {
                                    <div class="setting-value">@writeResult</div>
                                }
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

@code {
    private OpcUaRuntimeStatus _runtimeStatus = new();
    private OpcUaConnectionProfile? _profile;
    private List<OpcUaNodeMapping> _nodes = new();
    private IReadOnlyList<OpcUaTagSnapshot> _tagSnapshots = Array.Empty<OpcUaTagSnapshot>();
    private NodeDraft _newNode = new();
    private string? _message;
    private bool _messageIsError;
    private bool _canWrite;
    private bool _canAcknowledge;
    private bool _isDiscovering;
    private bool _isBrowsingTags;
    private bool _isImportingCertificate;
    private string _currentUsername = "operator";
    private string _discoveryUrl = "opc.tcp://127.0.0.1:4840";
    private string _discoveryAuthenticationMode = "Anonymous";
    private string? _discoveryUsername;
    private string? _discoveryPassword;
    private int _browseDepth = 6;
    private string _certificateImportTarget = nameof(OpcUaTrustStoreKind.ApplicationPeer);
    private List<OpcUaDiscoveredEndpoint> _discoveredEndpoints = new();
    private OpcUaDiscoveredEndpoint? _selectedDiscoveredEndpoint;
    private List<OpcUaDiscoveredTag> _discoveredTags = new();
    private List<OpcUaTrustedCertificateSummary> _trustedCertificates = new();
    private readonly CancellationTokenSource _pollingCts = new();
    private Task? _pollingTask;
    private readonly Dictionary<string, string> _pendingWrites = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _writeResults = new(StringComparer.OrdinalIgnoreCase);
    private int _alarmedTagCount;
    private int _staleTagCount;
    private int _activeAlarmCount;
    private int _unacknowledgedAlarmCount;
    private IReadOnlyList<OpcUaAlarmSnapshot> _alarms = Array.Empty<OpcUaAlarmSnapshot>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _canWrite = user.IsInRole(HmiRoles.Admin) || user.IsInRole(HmiRoles.Operator);
        _canAcknowledge = _canWrite;
        _currentUsername = user.Identity?.Name ?? user.Identity?.AuthenticationType ?? "operator";

        await LoadStateAsync();
        _pollingTask = PollRuntimeAsync(_pollingCts.Token);
    }

    private async Task LoadStateAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var profiles = await db.OpcUaConnectionProfiles
            .Include(x => x.NodeMappings)
            .ToListAsync();
        _profile = profiles
            .OrderByDescending(x => x.UpdatedUtc)
            .FirstOrDefault();
        if (_profile is not null)
        {
            // Credentials are write-only; never place persisted secrets in component state.
            _profile.Password = null;
            if (string.IsNullOrWhiteSpace(_discoveryUrl))
            {
                _discoveryUrl = _profile.EndpointUrl;
            }
        }
        _nodes = _profile?.NodeMappings.OrderBy(x => x.DisplayName).ToList() ?? new();
        _runtimeStatus = await OpcUaRuntime.GetStatusAsync();
        _tagSnapshots = await OpcUaRuntime.GetTagSnapshotsAsync();
        _alarms = await OpcUaRuntime.GetAlarmsAsync();
        _trustedCertificates = (await OpcUaCertificateStore.ListTrustedCertificatesAsync()).ToList();
        UpdateTagHealthCounts();
        UpdateAlarmCounts();
    }

    private async Task PollRuntimeAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _runtimeStatus = await OpcUaRuntime.GetStatusAsync(cancellationToken);
                _tagSnapshots = await OpcUaRuntime.GetTagSnapshotsAsync(cancellationToken);
                _alarms = await OpcUaRuntime.GetAlarmsAsync(false, cancellationToken);
                ReconcilePendingWriteValues();
                UpdateTagHealthCounts();
                UpdateAlarmCounts();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshConnectionAsync()
    {
        await OpcUaRuntime.RefreshNowAsync();
        SetMessage("Connection refresh requested.", false);
        await LoadStateAsync();
    }

    private async Task ToggleProfileEnabledAsync(bool enabled)
    {
        if (_profile is null)
        {
            SetMessage("No profile selected.", true);
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var persisted = await db.OpcUaConnectionProfiles.FirstOrDefaultAsync(x => x.Id == _profile.Id);
        if (persisted is null)
        {
            SetMessage("Profile no longer exists.", true);
            await LoadStateAsync();
            return;
        }

        persisted.Enabled = enabled;
        persisted.UpdatedUtc = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
        await RecordAuditAsync("OpcUaProfileEnabledStateChanged", persisted.Name, enabled ? "Enabled" : "Disabled");
        await OpcUaRuntime.RefreshNowAsync();
        SetMessage(enabled ? "Profile enabled." : "Profile disabled.", false);
        await LoadStateAsync();
    }

    private async Task SaveProfileAsync()
    {
        if (_profile is null)
        {
            SetMessage("No profile selected.", true);
            return;
        }

        if (!Uri.TryCreate(_profile.EndpointUrl, UriKind.Absolute, out var endpointUri)
            || !string.Equals(endpointUri.Scheme, "opc.tcp", StringComparison.OrdinalIgnoreCase))
        {
            SetMessage("Endpoint URL must be an absolute opc.tcp URL.", true);
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var persisted = await db.OpcUaConnectionProfiles.FirstOrDefaultAsync(x => x.Id == _profile.Id);
        if (persisted is null)
        {
            SetMessage("Profile no longer exists.", true);
            await LoadStateAsync();
            return;
        }

        persisted.Name = _profile.Name.Trim();
        persisted.EndpointUrl = _profile.EndpointUrl.Trim();
        persisted.AuthenticationMode = _profile.AuthenticationMode.Trim();
        persisted.SecurityPolicy = _profile.SecurityPolicy.Trim();
        persisted.SecurityMode = _profile.SecurityMode.Trim();
        persisted.PublishingIntervalMs = Math.Max(100, _profile.PublishingIntervalMs);
        persisted.Username = string.IsNullOrWhiteSpace(_profile.Username) ? null : _profile.Username.Trim();
        if (!string.IsNullOrWhiteSpace(_profile.Password))
        {
            persisted.ProtectedPassword = DataProtectionProvider
                .CreateProtector("IOTSnap.Hmi.OpcUaProfilePassword.v1")
                .Protect(_profile.Password);
            persisted.Password = null;
        }
        persisted.Enabled = _profile.Enabled;
        persisted.UseSecurity = _profile.UseSecurity;
        persisted.UpdatedUtc = DateTimeOffset.UtcNow;

        await db.SaveChangesAsync();
        await RecordAuditAsync("OpcUaProfileChanged", persisted.Name, "Succeeded");
        await OpcUaRuntime.RefreshNowAsync();
        SetMessage("Profile saved.", false);
        await LoadStateAsync();
    }

    private async Task OnTrustedCertificateSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _isImportingCertificate = true;

        try
        {
            var trustKind = Enum.Parse<OpcUaTrustStoreKind>(_certificateImportTarget, ignoreCase: true);
            await using var stream = file.OpenReadStream(2 * 1024 * 1024);
            var imported = await OpcUaCertificateStore.ImportTrustedCertificateAsync(file.Name, stream, trustKind);
            await RecordAuditAsync("OpcUaTrustedCertificateImported", imported.Thumbprint, "Succeeded");
            await OpcUaRuntime.RefreshNowAsync();
            SetMessage($"Imported {imported.Subject} into {DescribeTrustStore(imported.TrustKind)}.", false);
            await LoadStateAsync();
        }
        catch (Exception ex)
        {
            SetMessage($"Certificate import failed: {ex.Message}", true);
        }
        finally
        {
            _isImportingCertificate = false;
        }
    }

    private async Task DiscoverEndpointsAsync()
    {
        _isDiscovering = true;
        _discoveredTags.Clear();
        _selectedDiscoveredEndpoint = null;

        try
        {
            _discoveredEndpoints = (await OpcUaDiscovery.DiscoverEndpointsAsync(_discoveryUrl))
                .ToList();
            if (_discoveredEndpoints.Count == 0)
            {
                SetMessage("No OPC UA endpoints were discovered at the supplied URL.", true);
                return;
            }

            _selectedDiscoveredEndpoint = _discoveredEndpoints[0];
            SetMessage($"Discovered {_discoveredEndpoints.Count} endpoint(s).", false);
        }
        catch (Exception ex)
        {
            _discoveredEndpoints.Clear();
            SetMessage($"Discovery failed: {ex.Message}", true);
        }
        finally
        {
            _isDiscovering = false;
        }
    }

    private void SelectDiscoveredEndpoint(OpcUaDiscoveredEndpoint endpoint)
    {
        _selectedDiscoveredEndpoint = endpoint;
    }

    private void ApplyDiscoveredEndpoint(OpcUaDiscoveredEndpoint endpoint)
    {
        if (_profile is null)
        {
            SetMessage("No profile selected.", true);
            return;
        }

        _selectedDiscoveredEndpoint = endpoint;
        _profile.EndpointUrl = endpoint.EndpointUrl;
        _profile.UseSecurity = endpoint.UseSecurity;
        _profile.SecurityPolicy = endpoint.SecurityPolicy;
        _profile.SecurityMode = endpoint.SecurityMode;
        _profile.AuthenticationMode = endpoint.SupportsAnonymous ? "Anonymous" : "UsernamePassword";
        _discoveryUrl = endpoint.EndpointUrl;
        SetMessage($"Applied discovered endpoint {endpoint.EndpointUrl} to the profile. Save to persist it.", false);
    }

    private async Task BrowseSelectedEndpointAsync()
    {
        if (_selectedDiscoveredEndpoint is null)
        {
            SetMessage("Select a discovered endpoint before browsing tags.", true);
            return;
        }

        _isBrowsingTags = true;

        try
        {
            var request = new OpcUaBrowseRequest(
                _selectedDiscoveredEndpoint.EndpointUrl,
                _selectedDiscoveredEndpoint.UseSecurity,
                _selectedDiscoveredEndpoint.SecurityPolicy,
                _selectedDiscoveredEndpoint.SecurityMode,
                _discoveryAuthenticationMode,
                _discoveryUsername,
                _discoveryPassword,
                Math.Clamp(_browseDepth, 1, 12));

            _discoveredTags = (await OpcUaDiscovery.BrowseTagsAsync(request)).ToList();
            SetMessage(_discoveredTags.Count == 0
                ? "The selected endpoint did not return any browsable variable tags."
                : $"Discovered {_discoveredTags.Count} tag(s).", _discoveredTags.Count == 0);
        }
        catch (Exception ex)
        {
            _discoveredTags.Clear();
            SetMessage($"Tag browse failed: {ex.Message}", true);
        }
        finally
        {
            _isBrowsingTags = false;
        }
    }

    private void StageDiscoveredTag(OpcUaDiscoveredTag tag)
    {
        _newNode.DisplayName = tag.DisplayName;
        _newNode.NodeId = tag.NodeId;
        _newNode.Area = DeriveArea(tag.BrowsePath);
        _newNode.DataType = tag.DataType;
        _newNode.IsWritable = tag.IsWritable;
        SetMessage($"Staged {tag.NodeId} for a new mapping. Review it below and click Add Node.", false);
    }

    private async Task AddNodeAsync()
    {
        if (_profile is null)
        {
            SetMessage("No profile selected.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(_newNode.DisplayName) || string.IsNullOrWhiteSpace(_newNode.NodeId))
        {
            SetMessage("Display name and NodeId are required.", true);
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var profile = await db.OpcUaConnectionProfiles.FirstOrDefaultAsync(x => x.Id == _profile.Id);
        if (profile is null)
        {
            SetMessage("Profile no longer exists.", true);
            await LoadStateAsync();
            return;
        }

        db.OpcUaNodeMappings.Add(new OpcUaNodeMapping
        {
            OpcUaConnectionProfileId = profile.Id,
            DisplayName = _newNode.DisplayName.Trim(),
            NodeId = _newNode.NodeId.Trim(),
            Area = string.IsNullOrWhiteSpace(_newNode.Area) ? "Default" : _newNode.Area.Trim(),
            DataType = string.IsNullOrWhiteSpace(_newNode.DataType) ? "Auto" : _newNode.DataType.Trim(),
            SamplingIntervalMs = Math.Max(100, _newNode.SamplingIntervalMs),
            IsWritable = _newNode.IsWritable
        });
        profile.UpdatedUtc = DateTimeOffset.UtcNow;

        await db.SaveChangesAsync();
        await RecordAuditAsync("OpcUaNodeAdded", _newNode.NodeId, "Succeeded");
        await OpcUaRuntime.RefreshNowAsync();
        _newNode = new NodeDraft();
        SetMessage("Node added.", false);
        await LoadStateAsync();
    }

    private async Task DeleteNodeAsync(int nodeId)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var node = await db.OpcUaNodeMappings.FirstOrDefaultAsync(x => x.Id == nodeId);
        if (node is null)
        {
            SetMessage("Node no longer exists.", true);
            await LoadStateAsync();
            return;
        }

        var profile = await db.OpcUaConnectionProfiles.FirstOrDefaultAsync(x => x.Id == node.OpcUaConnectionProfileId);
        if (profile is not null)
        {
            profile.UpdatedUtc = DateTimeOffset.UtcNow;
        }

        db.OpcUaNodeMappings.Remove(node);
        await db.SaveChangesAsync();
        await RecordAuditAsync("OpcUaNodeDeleted", node.NodeId, "Succeeded");
        await OpcUaRuntime.RefreshNowAsync();
        SetMessage("Node deleted.", false);
        await LoadStateAsync();
    }

    private void SetMessage(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
    }

    private async Task RecordAuditAsync(string action, string resource, string result)
    {
        var actor = RuntimeAccessPolicy.ResolveActor((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
        if (actor is not null)
        {
            await AuditService.RecordAsync(actor, action, resource, result, null, null, CancellationToken.None);
        }
    }

    private static string DescribeAuth(OpcUaDiscoveredEndpoint endpoint)
        => endpoint.SupportsAnonymous && endpoint.SupportsUsernamePassword
            ? "Anonymous, UsernamePassword"
            : endpoint.SupportsUsernamePassword
                ? "UsernamePassword"
                : "Anonymous";

    private static string DescribeTrustStore(OpcUaTrustStoreKind trustKind)
        => trustKind switch
        {
            OpcUaTrustStoreKind.ApplicationPeer => "Trusted Application",
            OpcUaTrustStoreKind.IssuerAuthority => "Trusted Issuer",
            _ => trustKind.ToString()
        };

    private static string DeriveArea(string browsePath)
    {
        var segments = browsePath.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return segments.Length >= 2 ? segments[^2] : "Discovered";
    }

    private string GetPendingWriteValue(OpcUaTagSnapshot tag)
    {
        if (_pendingWrites.TryGetValue(tag.NodeId, out var pending))
        {
            return pending;
        }

        return tag.ValueText ?? string.Empty;
    }

    private void SetPendingWriteValue(string nodeId, string value)
    {
        _pendingWrites[nodeId] = value;
    }

    private async Task WriteTagAsync(OpcUaTagSnapshot tag)
    {
        if (!_canWrite)
        {
            SetMessage("Your role is not allowed to write tags.", true);
            return;
        }

        if (!tag.IsWritable)
        {
            SetMessage("Tag is read-only.", true);
            return;
        }

        var value = GetPendingWriteValue(tag);
        var result = await OpcUaRuntime.WriteTagAsync(tag.NodeId, value);
        _writeResults[tag.NodeId] = result.Message;

        if (!result.Succeeded)
        {
            SetMessage(result.Message, true);
            return;
        }

        SetMessage($"Write sent for {tag.DisplayName}.", false);
    }

    private void ReconcilePendingWriteValues()
    {
        var existingNodeIds = _tagSnapshots
            .Select(x => x.NodeId)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var stalePending = _pendingWrites.Keys
            .Where(x => !existingNodeIds.Contains(x))
            .ToList();

        foreach (var nodeId in stalePending)
        {
            _pendingWrites.Remove(nodeId);
            _writeResults.Remove(nodeId);
        }
    }

    private void UpdateTagHealthCounts()
    {
        _alarmedTagCount = _tagSnapshots.Count(x => x.HasAlarm);
        _staleTagCount = _tagSnapshots.Count(x => x.IsStale);
    }

    private void UpdateAlarmCounts()
    {
        _activeAlarmCount = _alarms.Count(x => x.IsActive);
        _unacknowledgedAlarmCount = _alarms.Count(x => !x.IsAcknowledged);
    }

    private async Task AcknowledgeAlarmAsync(string nodeId)
    {
        if (!_canAcknowledge)
        {
            SetMessage("Your role is not allowed to acknowledge alarms.", true);
            return;
        }

        var result = await OpcUaRuntime.AcknowledgeAlarmAsync(nodeId, _currentUsername);
        SetMessage(result.Message, !result.Succeeded);

        if (result.Succeeded)
        {
            _alarms = await OpcUaRuntime.GetAlarmsAsync();
            UpdateAlarmCounts();
        }
    }

    private sealed class NodeDraft
    {
        public string DisplayName { get; set; } = string.Empty;
        public string NodeId { get; set; } = string.Empty;
        public string Area { get; set; } = "Default";
        public string DataType { get; set; } = "Auto";
        public int SamplingIntervalMs { get; set; } = 1000;
        public bool IsWritable { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        _pollingCts.Cancel();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _pollingCts.Dispose();
    }
}
