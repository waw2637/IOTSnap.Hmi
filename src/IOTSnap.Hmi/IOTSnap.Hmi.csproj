<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\IOTSnap.Hmi.Data\IOTSnap.Hmi.Data.csproj" />
    <ProjectReference Include="..\IOTSnap.Hmi.Runtime\IOTSnap.Hmi.Runtime.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <EnableDevSetupBypass>false</EnableDevSetupBypass>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDevSetupBypass)' == 'true'">
    <DefineConstants>$(DefineConstants);DEV_SETUP_BYPASS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
